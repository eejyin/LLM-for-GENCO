# Copy this file to .env.local, then edit the absolute paths for your machine.
GENCO_ROOT=/absolute/path/to/IBM OpenGridFM
# Optional: Python with GraphKit training dependencies; omit to use the web interpreter.
# GENCO_PYTHON=/absolute/path/to/training-env/bin/python
# Optional: Python with pandapower and NumPy.
# BENCHMARK_PYTHON=/absolute/path/to/benchmark-env/bin/python
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
# Optional OpenAI provider: keep the key in .env.local, never in Git.
# OPENAI_API_KEY=your-key-here
# Optional MATPOWER benchmark:
# MATPOWER_ROOT=/absolute/path/to/matpower
# OCTAVE_BIN=/absolute/path/to/octave
